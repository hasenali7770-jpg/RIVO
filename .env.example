# =============================================================================
# RIVO — environment template
# =============================================================================
# Copy to `.env` and fill in. NEVER commit a filled-in .env (it is gitignored).
#
# Every value below is REAL infrastructure configuration. There are no demo
# credentials in this file and none are shipped anywhere in the repository.
# Where a credential is missing, the matching feature refuses to run and says so
# explicitly — it never silently pretends to succeed.
#
# Legend:
#   [required]        API will not boot without it
#   [required-prod]   API will not boot when APP_ENV=production
#   [optional]        feature degrades in a documented, visible way
# =============================================================================

# --- Core -------------------------------------------------------------------
# development | staging | production                                [required]
APP_ENV=development
# Port the NestJS API listens on.
PORT=3000
# Public base URL of the API, used to build webhook and callback URLs. [required]
API_BASE_URL=http://localhost:3000
# Public marketing/web site, used in emails and store listings.     [optional]
WEB_APP_URL=http://localhost:3001
# Admin dashboard origin. Must be exact — it is CORS-allow-listed.  [required]
ADMIN_URL=http://localhost:3002
# Comma-separated extra CORS origins. Mobile apps do not need one.  [optional]
CORS_EXTRA_ORIGINS=
# Deep-link scheme used by the mobile app (rivo://property/<id>).
APP_DEEP_LINK_SCHEME=rivo
# IANA timezone used for traffic time-bucketing and reports.
DEFAULT_TIMEZONE=Asia/Baghdad
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- Data stores ------------------------------------------------------------
# PostgreSQL 16+ WITH the PostGIS extension available.              [required]
# The role must be allowed to run CREATE EXTENSION postgis on first migrate,
# or an operator must create the extension once by hand beforehand.
DATABASE_URL=postgresql://rivo:CHANGE_ME@localhost:5432/rivo?schema=public
# Connection pool ceiling for the API process.
DATABASE_POOL_SIZE=10
# Redis/Valkey 7+ — cache, rate limits, BullMQ queues, live state.  [required]
REDIS_URL=redis://localhost:6379
# Optional separate Redis for BullMQ. Defaults to REDIS_URL.        [optional]
QUEUE_REDIS_URL=

# --- Auth -------------------------------------------------------------------
# Generate each with: openssl rand -base64 48                       [required]
# Minimum 32 characters. The API refuses to boot on shorter values,
# and refuses to boot in production if the two are equal.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access token lifetime (zeit/ms format).
JWT_ACCESS_TTL=15m
# Refresh token lifetime in days.
JWT_REFRESH_TTL_DAYS=60
# Admin dashboard session lifetime in hours.
ADMIN_SESSION_TTL_HOURS=12
# Bootstrap Super Admin, created by `npm run seed -w @rivo/api` if absent.
# Change the password immediately after first login — the seeded account is
# flagged must_change_password.                                     [required]
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Sample content ---------------------------------------------------------
# Both are refused outright when APP_ENV=production, and every row they create
# is flagged is_demo and titled "[عينة]".
# Draft listings with no photos, plus road incidents — enough to exercise the
# map and search locally. They cannot reach PUBLISHED: the 8-photo rule and the
# photo-count constraint both refuse it.
RIVO_SEED_DEMO=false
# For a demonstration that has to look like the product: the same listings with
# eight sample photos each and a settled 3,000 IQD fee, most published and two
# left in the moderation queue. Implies RIVO_SEED_DEMO.
RIVO_SEED_DEMO_PUBLISHED=false

# --- Mapbox -----------------------------------------------------------------
# Public token (pk.*) shipped to the mobile app for map rendering ONLY.
# Restrict it by URL/bundle id in the Mapbox dashboard.             [required]
MAPBOX_PUBLIC_TOKEN=
# Secret token (sk.*) used server-side for Geocoding and Directions. Neither
# API needs a special scope, so the default scopes are enough.
# NEVER ship this to a client.                                      [required]
MAPBOX_SECRET_TOKEN=
# Style URLs used by the mobile app. Leave as-is to use RIVO-tuned defaults.
MAPBOX_STYLE_DARK=mapbox://styles/mapbox/navigation-night-v1
MAPBOX_STYLE_LIGHT=mapbox://styles/mapbox/navigation-day-v1
# Secret token (sk.*) with the Downloads:Read scope. Gradle and CocoaPods use
# it to fetch the native Mapbox SDK; without it a mobile build fails with a
# bare 401. Not needed by the API itself, and it belongs on the build machine
# (~/.gradle/gradle.properties, ~/.netrc) or in a CI secret rather than here.
# See apps/mobile/MAPBOX_SETUP.md.        [required to build the mobile app]
MAPBOX_DOWNLOADS_TOKEN=

# --- Cloudflare R2 (property images) ----------------------------------------
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=rivo-media
# Custom domain or r2.dev URL serving the bucket. Used to build media URLs.
# Leave empty in production: photos are then served from R2 over a signed URL
# or your bucket's custom domain. For a demonstration with no Cloudflare account,
# point it at the API's own sample-photo path:
#   R2_PUBLIC_BASE_URL=http://localhost:3000/demo-media
R2_PUBLIC_BASE_URL=
# Override only if you use an S3-compatible endpoint other than R2.
R2_ENDPOINT=
# Minutes a presigned PUT URL stays valid.
R2_PRESIGN_TTL_MINUTES=15
# Minutes a presigned GET URL stays valid when serving private objects.
R2_DOWNLOAD_TTL_MINUTES=60

# --- Cloudflare Stream (property Reels) -------------------------------------
# API token with Stream:Edit on the RIVO account.                   [optional]
# Without it, reel upload is disabled and the app hides the entry point
# (feature flag `reels_enabled`) instead of showing a dead button.
CLOUDFLARE_STREAM_TOKEN=
# The customer subdomain code from your Stream playback URLs
# (customer-<CODE>.cloudflarestream.com).
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Shared secret configured on the Stream webhook in the Cloudflare dashboard.
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# Seconds a direct-creator-upload URL remains valid.
STREAM_UPLOAD_TTL_SECONDS=3600

# --- AI provider (photo/video enhancement) ----------------------------------
# replicate | none                                                  [optional]
# `none` disables enhancement: originals are published unchanged and every
# AI job is recorded as SKIPPED. It never fabricates an "enhanced" asset.
AI_PROVIDER=none
REPLICATE_API_TOKEN=
# Model used for photo restoration/upscale. Must be a non-generative,
# detail-preserving model — see docs/architecture/AI_ENHANCEMENT.md.
REPLICATE_PHOTO_MODEL=nightmareai/real-esrgan
REPLICATE_PHOTO_MODEL_VERSION=
# Hard ceiling on AI spend per property, in USD. Jobs above it are SKIPPED.
AI_MAX_COST_USD_PER_PROPERTY=0.50
AI_JOB_TIMEOUT_SECONDS=180

# --- SMS OTP ----------------------------------------------------------------
# console | http                                                    [required]
#   console : development only. Prints the OTP to the API log. The API REFUSES
#             to boot with this provider when APP_ENV=production.
#   http    : generic HTTP SMS gateway — configure the three OTP_HTTP_* values
#             below for your Iraqi provider once the contract is signed.
OTP_PROVIDER=console
OTP_API_KEY=
OTP_SENDER_ID=RIVO
# Endpoint that accepts the send request (POST).
OTP_HTTP_URL=
# Request body template. {{phone}}, {{code}}, {{sender}}, {{apiKey}} are substituted.
OTP_HTTP_BODY_TEMPLATE={"to":"{{phone}}","from":"{{sender}}","text":"RIVO code: {{code}}"}
# Extra headers as JSON, e.g. {"Authorization":"Bearer {{apiKey}}"}
OTP_HTTP_HEADERS={"Content-Type":"application/json","Authorization":"Bearer {{apiKey}}"}
# JSON path to the provider message id in the response, for delivery tracing.
OTP_HTTP_MESSAGE_ID_PATH=id

# --- Payment gateway (3,000 IQD listing fee) --------------------------------
# manual | hmac_gateway                                             [required]
#   manual        : no online gateway yet. A payment can only be settled by an
#                   authenticated FINANCE/SUPER_ADMIN, and every settlement is
#                   audit-logged. Nothing is ever auto-marked as paid.
#   hmac_gateway  : generic HMAC-signed redirect + webhook gateway. Fill the
#                   PAYMENT_* values below from your merchant agreement.
PAYMENT_PROVIDER=manual
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET=
# Secret used to verify the webhook signature. MUST differ from PAYMENT_SECRET.
PAYMENT_WEBHOOK_SECRET=
# Gateway endpoint that creates a checkout session.
PAYMENT_CREATE_URL=
# Header carrying the webhook signature.
PAYMENT_WEBHOOK_SIGNATURE_HEADER=x-signature
# sha256 | sha512
PAYMENT_WEBHOOK_SIGNATURE_ALGO=sha256
# Reject a webhook whose timestamp is older than this (replay protection).
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Minutes an unpaid payment intent stays open before expiring.
PAYMENT_INTENT_TTL_MINUTES=60

# --- Observability ----------------------------------------------------------
SENTRY_DSN_API=
SENTRY_DSN_MOBILE=
SENTRY_DSN_ADMIN=
# 0.0–1.0 performance trace sample rate.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Release identifier reported to Sentry; CI sets it to the git SHA.
SENTRY_RELEASE=

# --- Rate limiting ----------------------------------------------------------
# Default API budget per IP.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
# Tighter budget for the routing proxy, which costs money per call.
ROUTING_RATE_LIMIT_PER_MINUTE=30
# Admin sign-in attempts per IP per 5 minutes. Raise it if several operators
# share one office address; the per-account lockout (5 failures = 15 minutes) is
# the real brute-force defence and is not configurable.
ADMIN_LOGIN_ATTEMPTS_PER_5MIN=10

# --- Admin dashboard (apps/admin) -------------------------------------------
# Browser-visible. Must be reachable from the operator's machine.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_MAPBOX_PUBLIC_TOKEN=
NEXT_PUBLIC_APP_ENV=development
