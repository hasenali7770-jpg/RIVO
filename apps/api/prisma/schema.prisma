// !! IMPORTANT — hand-written SQL objects live outside this file !!
//
// The initial migration also creates objects Prisma cannot express:
//   * GiST indexes on the geography columns (property_locations, road_incidents,
//     road_speed_samples, saved_places)
//   * GIN trigram indexes for Arabic text search on properties
//   * partial indexes for the published / pending-review / ready-reel hot paths
//   * CHECK constraints for the 8-18 photo rule, the 1080p reel rule and the
//     3,000 IQD fee
//   * the append-only triggers on audit_logs and payment_events
//   * the counter-sync triggers on property_media and favorites
//
// `prisma migrate diff` will therefore always report those as "missing" from the
// datamodel. That is expected. NEVER run `prisma migrate dev` against a database
// you care about: it would generate a migration that DROPS them. Write a new SQL
// migration by hand instead, exactly as prisma/migrations/20260101000000_init
// does, and apply it with `prisma migrate deploy`.
// See docs/architecture/DATABASE.md.

// RIVO database schema — Master Plan §10.
//
// Notes for maintainers:
//  * All primary keys are UUID v4 generated by PostgreSQL (gen_random_uuid()).
//  * Geospatial columns use PostGIS `geography(Point, 4326)`. Prisma has no native
//    type for these, so they are declared `Unsupported(...)`: Prisma manages the
//    column and its index, while reads/writes go through raw SQL in
//    `src/common/geo/geo.repository.ts`. This is deliberate — it keeps PostGIS
//    fully available (ST_DWithin, ST_Distance, KNN `<->`) instead of degrading
//    geospatial search to a bounding-box approximation.
//  * Migrations are hand-written SQL under prisma/migrations and applied with
//    `prisma migrate deploy`. They are verified against an empty database in CI.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PropertyType {
  HOUSE
  APARTMENT
  SHOP
  BUILDING
  LAND
  COMMERCIAL

  @@map("property_type")
}

enum ListingPurpose {
  SALE
  RENT

  @@map("listing_purpose")
}

enum PropertyStatus {
  DRAFT
  AWAITING_PAYMENT
  PENDING_REVIEW
  CHANGES_REQUESTED
  REJECTED
  PUBLISHED
  ARCHIVED
  SOLD
  RENTED

  @@map("property_status")
}

enum SellerType {
  INDIVIDUAL
  OFFICE
  DEVELOPER

  @@map("seller_type")
}

enum ContactPreference {
  CALL
  WHATSAPP
  BOTH

  @@map("contact_preference")
}

enum IncidentType {
  ACCIDENT
  TRAFFIC_JAM
  ROAD_CLOSURE
  ROAD_WORKS
  FLOODED_ROAD
  POTHOLE
  HAZARD

  @@map("incident_type")
}

enum IncidentStatus {
  ACTIVE
  EXPIRED
  REMOVED
  PENDING_REVIEW

  @@map("incident_status")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED

  @@map("payment_status")
}

enum MediaKind {
  ORIGINAL
  ENHANCED

  @@map("media_kind")
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  CANCELLED

  @@map("job_status")
}

enum VideoStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  VALIDATION_FAILED
  READY
  REJECTED

  @@map("video_status")
}

enum AdminRole {
  SUPER_ADMIN
  MODERATOR
  FINANCE
  SUPPORT

  @@map("admin_role")
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED

  @@map("report_status")
}

// ---------------------------------------------------------------------------
// Identity & auth — Master Plan §8
// ---------------------------------------------------------------------------

model User {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// E.164, e.g. +9647XXXXXXXXX. Unique across the platform.
  phoneE164        String     @unique @map("phone_e164") @db.VarChar(20)
  phoneVerified    Boolean    @default(false) @map("phone_verified")
  displayName      String?    @map("display_name") @db.VarChar(120)
  avatarKey        String?    @map("avatar_key") @db.VarChar(512)
  sellerType       SellerType @default(INDIVIDUAL) @map("seller_type")
  locale           String     @default("ar") @db.VarChar(8)
  /// Set when the user is banned; blocks token issue and all writes.
  blockedAt        DateTime?  @map("blocked_at") @db.Timestamptz(3)
  blockedReason    String?    @map("blocked_reason")
  /// Master Plan §4 — telemetry is opt-in and revocable.
  telemetryOptIn   Boolean    @default(false) @map("telemetry_opt_in")
  telemetryOptInAt DateTime?  @map("telemetry_opt_in_at") @db.Timestamptz(3)
  marketingOptIn   Boolean    @default(false) @map("marketing_opt_in")
  lastSeenAt       DateTime?  @map("last_seen_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz(3)

  devices          UserDevice[]
  refreshSessions  RefreshSession[]
  sellerProfile    SellerProfile?
  properties       Property[]
  favorites        Favorite[]
  payments         ListingPayment[]
  verifications    SellerVerification[]
  incidents        RoadIncident[]
  incidentConfirms RoadIncidentConfirmation[]
  routeFeedback    RouteFeedback[]
  notifications    Notification[]
  reportsFiled     PropertyReport[]           @relation("ReporterUser")
  savedPlaces      SavedPlace[]
  reelViews        ReelViewEvent[]

  @@index([createdAt])
  @@index([sellerType])
  @@map("users")
}

model UserDevice {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// Client-generated stable device id (not an advertising identifier).
  deviceKey    String    @map("device_key") @db.VarChar(128)
  platform     String    @db.VarChar(16)
  appVersion   String?   @map("app_version") @db.VarChar(32)
  osVersion    String?   @map("os_version") @db.VarChar(64)
  model        String?   @db.VarChar(120)
  pushToken    String?   @map("push_token") @db.VarChar(512)
  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions RefreshSession[]

  @@unique([userId, deviceKey])
  @@index([userId])
  @@map("user_devices")
}

model OtpChallenge {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneE164      String    @map("phone_e164") @db.VarChar(20)
  /// scrypt hash of the OTP code. The plaintext code is never stored.
  codeHash       String    @map("code_hash") @db.VarChar(255)
  /// Opaque token returned to the client; must be replayed on verify.
  challengeToken String    @unique @map("challenge_token") @db.VarChar(64)
  purpose        String    @default("LOGIN") @db.VarChar(32)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(3)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  requestIp      String?   @map("request_ip") @db.VarChar(64)
  /// Provider message id, for delivery troubleshooting with the SMS vendor.
  providerRef    String?   @map("provider_ref") @db.VarChar(128)
  providerName   String?   @map("provider_name") @db.VarChar(32)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phoneE164, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model RefreshSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  deviceId      String?   @map("device_id") @db.Uuid
  /// SHA-256 of the refresh token. Raw refresh tokens are never stored.
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  /// Rotation chain: the session this one replaced.
  replacedById  String?   @map("replaced_by_id") @db.Uuid
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  ip            String?   @db.VarChar(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(64)
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  device UserDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_sessions")
}

model SellerProfile {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String             @unique @map("user_id") @db.Uuid
  sellerType      SellerType         @default(INDIVIDUAL) @map("seller_type")
  officeName      String?            @map("office_name") @db.VarChar(200)
  officeLicenseNo String?            @map("office_license_no") @db.VarChar(120)
  about           String?
  contactPhone    String?            @map("contact_phone") @db.VarChar(20)
  whatsappPhone   String?            @map("whatsapp_phone") @db.VarChar(20)
  logoKey         String?            @map("logo_key") @db.VarChar(512)
  /// Badge is rendered only when this is VERIFIED — Master Plan §8.
  verification    VerificationStatus @default(NONE)
  verifiedAt      DateTime?          @map("verified_at") @db.Timestamptz(3)
  listingsCount   Int                @default(0) @map("listings_count")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verification])
  @@map("seller_profiles")
}

model SellerVerification {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  status            VerificationStatus @default(PENDING)
  requestedType     SellerType         @map("requested_type")
  /// R2 object keys of submitted documents. Access is admin-only and audited.
  documentKeys      String[]           @map("document_keys")
  note              String?
  reviewedByAdminId String?            @map("reviewed_by_admin_id") @db.Uuid
  reviewedAt        DateTime?          @map("reviewed_at") @db.Timestamptz(3)
  rejectionReason   String?            @map("rejection_reason")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy AdminUser? @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@map("seller_verifications")
}

// ---------------------------------------------------------------------------
// Darcom — properties & media — Master Plan §5, §6
// ---------------------------------------------------------------------------

model Property {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Short human-readable reference shown to users and support, e.g. "RV-8F3K2Q".
  reference          String            @unique @db.VarChar(16)
  ownerId            String            @map("owner_id") @db.Uuid
  type               PropertyType
  purpose            ListingPurpose
  status             PropertyStatus    @default(DRAFT)
  title              String            @db.VarChar(160)
  description        String?
  /// Whole Iraqi dinars. BigInt because prices exceed 2^31 (e.g. 250,000,000 IQD).
  priceIqd           BigInt            @map("price_iqd")
  /// Rent period when purpose = RENT: MONTHLY | YEARLY.
  rentPeriod         String?           @map("rent_period") @db.VarChar(16)
  areaSqm            Decimal           @map("area_sqm") @db.Decimal(12, 2)
  bedrooms           Int?
  bathrooms          Int?
  floors             Int?
  floorNumber        Int?              @map("floor_number")
  yearBuilt          Int?              @map("year_built")
  furnished          Boolean?
  governorate        String            @db.VarChar(32)
  city               String?           @db.VarChar(120)
  district           String?           @db.VarChar(120)
  addressLine        String?           @map("address_line") @db.VarChar(300)
  contactPreference  ContactPreference @default(BOTH) @map("contact_preference")
  contactPhone       String?           @map("contact_phone") @db.VarChar(20)
  /// Cached from seller_profiles so feed queries do not need a join.
  sellerType         SellerType        @default(INDIVIDUAL) @map("seller_type")
  isVerifiedListing  Boolean           @default(false) @map("is_verified_listing")
  /// TRUE only for seeded sample content — Master Plan §5 and §21.
  isDemo             Boolean           @default(false) @map("is_demo")
  coverMediaId       String?           @map("cover_media_id") @db.Uuid
  photoCount         Int               @default(0) @map("photo_count")
  viewCount          Int               @default(0) @map("view_count")
  favoriteCount      Int               @default(0) @map("favorite_count")
  contactCount       Int               @default(0) @map("contact_count")
  submittedAt        DateTime?         @map("submitted_at") @db.Timestamptz(3)
  publishedAt        DateTime?         @map("published_at") @db.Timestamptz(3)
  expiresAt          DateTime?         @map("expires_at") @db.Timestamptz(3)
  /// Populated on REJECTED / CHANGES_REQUESTED and shown to the seller.
  moderationReason   String?           @map("moderation_reason")
  moderatedByAdminId String?           @map("moderated_by_admin_id") @db.Uuid
  moderatedAt        DateTime?         @map("moderated_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz(3)

  owner        User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  moderatedBy  AdminUser?            @relation(fields: [moderatedByAdminId], references: [id], onDelete: SetNull)
  location     PropertyLocation?
  media        PropertyMedia[]
  videos       PropertyVideo[]
  favorites    Favorite[]
  payments     ListingPayment[]
  reports      PropertyReport[]
  statusEvents PropertyStatusEvent[]

  @@index([status, publishedAt])
  @@index([type, purpose, status])
  @@index([governorate, status])
  @@index([priceIqd])
  @@index([ownerId, status])
  @@index([areaSqm])
  @@map("properties")
}

/// Separate table so the PostGIS point and its GiST index stay isolated from the
/// hot property row, and so an approximate public point can be stored alongside
/// the exact one (Master Plan §6 step 3).
model PropertyLocation {
  propertyId       String                                 @id @map("property_id") @db.Uuid
  /// Exact seller-placed pin. Never returned to non-owner clients when
  /// `displayPrecision` = APPROXIMATE.
  point            Unsupported("geography(Point, 4326)")
  /// Jittered point used for public display when precision is APPROXIMATE.
  publicPoint      Unsupported("geography(Point, 4326)")? @map("public_point")
  lat              Float
  lng              Float
  publicLat        Float?                                 @map("public_lat")
  publicLng        Float?                                 @map("public_lng")
  /// EXACT | APPROXIMATE
  displayPrecision String                                 @default("EXACT") @map("display_precision") @db.VarChar(16)
  /// Radius in metres used to generate the approximate point.
  approxRadiusM    Int                                    @default(300) @map("approx_radius_m")
  /// Reverse-geocoded label cached from Mapbox at pin time.
  placeLabel       String?                                @map("place_label") @db.VarChar(300)
  createdAt        DateTime                               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_locations")
}

/// One row per stored image asset. An original and its enhanced derivative are
/// two rows linked by `sourceMediaId` — Master Plan §6 step 6 requires both to be
/// stored separately and to remain comparable.
model PropertyMedia {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  kind            MediaKind @default(ORIGINAL)
  /// R2 object key. Never a public URL — URLs are signed at read time.
  objectKey       String    @map("object_key") @db.VarChar(512)
  bucket          String    @db.VarChar(120)
  mimeType        String    @map("mime_type") @db.VarChar(80)
  sizeBytes       Int       @map("size_bytes")
  width           Int?
  height          Int?
  /// SHA-256 of the object, used to detect duplicate uploads across listings.
  checksumSha256  String?   @map("checksum_sha256") @db.VarChar(64)
  /// Ordering within the gallery. Cover is chosen via Property.coverMediaId.
  position        Int       @default(0)
  /// For an ENHANCED row: the ORIGINAL it was derived from.
  sourceMediaId   String?   @map("source_media_id") @db.Uuid
  /// Which version the seller chose to publish. Exactly one of the pair is true.
  isSelected      Boolean   @default(true) @map("is_selected")
  /// FALSE until the client confirms the direct-to-R2 upload completed and the
  /// server has verified the object exists with the expected size and type.
  uploadConfirmed Boolean   @default(false) @map("upload_confirmed")
  /// Result of automated content checks (blank/blurred/non-property/duplicate).
  qualityScore    Float?    @map("quality_score")
  qualityNotes    Json?     @map("quality_notes")
  isDemo          Boolean   @default(false) @map("is_demo")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sourceMedia PropertyMedia?  @relation("MediaDerivation", fields: [sourceMediaId], references: [id], onDelete: Cascade)
  derivatives PropertyMedia[] @relation("MediaDerivation")
  aiJobs      AiJob[]
  mediaJobs   MediaJob[]

  @@unique([bucket, objectKey])
  @@index([propertyId, kind, position])
  @@index([sourceMediaId])
  @@map("property_media")
}

/// Property Reels — Master Plan §6 step 7 and §7. Always bound to one property.
model PropertyVideo {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId         String      @map("property_id") @db.Uuid
  status             VideoStatus @default(PENDING_UPLOAD)
  /// Cloudflare Stream UID.
  streamUid          String?     @unique @map("stream_uid") @db.VarChar(64)
  /// One-time direct-creator-upload URL handed to the device. Not a secret after use.
  uploadUrlExpiresAt DateTime?   @map("upload_url_expires_at") @db.Timestamptz(3)
  playbackHlsUrl     String?     @map("playback_hls_url") @db.VarChar(512)
  playbackDashUrl    String?     @map("playback_dash_url") @db.VarChar(512)
  thumbnailUrl       String?     @map("thumbnail_url") @db.VarChar(512)
  /// Seconds into the video used as the cover frame (AI-suggested, seller-confirmed).
  coverTimeSeconds   Float?      @map("cover_time_seconds")
  durationSeconds    Float?      @map("duration_seconds")
  width              Int?
  height             Int?
  /// Server-measured. The 1080p rule is enforced against these, never client metadata.
  shortEdge          Int?        @map("short_edge")
  bitrateKbps        Int?        @map("bitrate_kbps")
  sizeBytes          BigInt?     @map("size_bytes")
  caption            String?     @db.VarChar(300)
  /// Populated when validation rejects the file, and shown to the seller verbatim.
  validationError    String?     @map("validation_error")
  validationDetails  Json?       @map("validation_details")
  viewCount          Int         @default(0) @map("view_count")
  /// Sum of watched fraction over all view events; feeds the ranking score.
  completionSum      Float       @default(0) @map("completion_sum")
  publishedAt        DateTime?   @map("published_at") @db.Timestamptz(3)
  isDemo             Boolean     @default(false) @map("is_demo")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  property   Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  viewEvents ReelViewEvent[]
  mediaJobs  MediaJob[]

  @@index([propertyId])
  @@index([status, publishedAt])
  @@map("property_videos")
}

model ReelViewEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  videoId        String   @map("video_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  /// Pseudonymous id for signed-out viewers. Never an advertising identifier.
  anonId         String?  @map("anon_id") @db.VarChar(64)
  watchedSeconds Float    @map("watched_seconds")
  /// 0..1 fraction of the reel watched; clamped server-side.
  completion     Float
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  video PropertyVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([videoId, createdAt])
  @@index([userId])
  @@map("reel_view_events")
}

model Favorite {
  userId     String   @map("user_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([userId, propertyId])
  @@index([propertyId])
  @@map("favorites")
}

model PropertyReport {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId        String       @map("property_id") @db.Uuid
  reporterId        String?      @map("reporter_id") @db.Uuid
  /// FAKE_LISTING | WRONG_PRICE | SOLD_ALREADY | WRONG_LOCATION | OFFENSIVE | DUPLICATE | OTHER
  reason            String       @db.VarChar(40)
  note              String?
  status            ReportStatus @default(OPEN)
  resolvedByAdminId String?      @map("resolved_by_admin_id") @db.Uuid
  resolvedAt        DateTime?    @map("resolved_at") @db.Timestamptz(3)
  resolutionNote    String?      @map("resolution_note")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  property   Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reporter   User?      @relation("ReporterUser", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy AdminUser? @relation(fields: [resolvedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([propertyId])
  @@map("property_reports")
}

/// Append-only history of every property status transition. Gives support and
/// the seller an exact answer to "why is my listing in this state?".
model PropertyStatusEvent {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId String          @map("property_id") @db.Uuid
  fromStatus PropertyStatus? @map("from_status")
  toStatus   PropertyStatus  @map("to_status")
  /// USER | ADMIN | SYSTEM | PAYMENT_WEBHOOK
  actorType  String          @map("actor_type") @db.VarChar(20)
  actorId    String?         @map("actor_id") @db.Uuid
  reason     String?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, createdAt])
  @@map("property_status_events")
}

// ---------------------------------------------------------------------------
// Payments — Master Plan §6 step 9
// ---------------------------------------------------------------------------

/// One payment attempt for one listing. `amountIqd` is written by the server and
/// is never accepted from the client. Only a verified webhook may set status=PAID.
model ListingPayment {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId       String        @map("property_id") @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  /// Always LISTING_FEE_IQD (3000) for a standard listing.
  amountIqd        Int           @map("amount_iqd")
  currency         String        @default("IQD") @db.VarChar(3)
  status           PaymentStatus @default(PENDING)
  provider         String        @db.VarChar(40)
  /// Provider-side order/transaction id. Unique per provider.
  providerRef      String?       @map("provider_ref") @db.VarChar(160)
  /// Our idempotency key sent to the provider and echoed back in the webhook.
  merchantRef      String        @unique @map("merchant_ref") @db.VarChar(64)
  checkoutUrl      String?       @map("checkout_url") @db.VarChar(1024)
  /// Reason a payment failed, surfaced to the user.
  failureReason    String?       @map("failure_reason")
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(3)
  expiresAt        DateTime?     @map("expires_at") @db.Timestamptz(3)
  refundedAt       DateTime?     @map("refunded_at") @db.Timestamptz(3)
  /// Set when a FINANCE/SUPER_ADMIN settles an offline payment. Always audited.
  settledByAdminId String?       @map("settled_by_admin_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  property  Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  settledBy AdminUser?     @relation(fields: [settledByAdminId], references: [id], onDelete: SetNull)
  events    PaymentEvent[]

  @@unique([provider, providerRef])
  @@index([status, createdAt])
  @@index([propertyId])
  @@index([userId, createdAt])
  @@map("listing_payments")
}

/// Immutable log of every webhook/callback received, including rejected ones.
/// Keeping invalid attempts is deliberate: it is the evidence trail for disputes
/// and for detecting a forged-signature attack.
model PaymentEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId       String?   @map("payment_id") @db.Uuid
  provider        String    @db.VarChar(40)
  /// Provider event type, verbatim.
  eventType       String    @map("event_type") @db.VarChar(80)
  /// Provider event id; used to make webhook handling idempotent.
  providerEventId String?   @map("provider_event_id") @db.VarChar(160)
  signatureValid  Boolean   @map("signature_valid")
  /// Why the event was not applied, when applicable.
  rejectionReason String?   @map("rejection_reason") @db.VarChar(200)
  payload         Json
  headers         Json?
  sourceIp        String?   @map("source_ip") @db.VarChar(64)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  payment ListingPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId, createdAt])
  @@index([createdAt])
  @@map("payment_events")
}

// ---------------------------------------------------------------------------
// Background jobs — Master Plan §6 steps 5-7
// ---------------------------------------------------------------------------

/// Media pipeline work: object verification, probing, thumbnailing, transcode watch.
model MediaJob {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// IMAGE_VERIFY | IMAGE_PROBE | VIDEO_VALIDATE | VIDEO_POLL_STREAM
  type        String    @db.VarChar(40)
  status      JobStatus @default(QUEUED)
  mediaId     String?   @map("media_id") @db.Uuid
  videoId     String?   @map("video_id") @db.Uuid
  /// BullMQ job id, for cross-referencing queue state with the database.
  queueJobId  String?   @map("queue_job_id") @db.VarChar(80)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  error       String?
  result      Json?
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  media PropertyMedia? @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  video PropertyVideo? @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([mediaId])
  @@index([videoId])
  @@map("media_jobs")
}

/// AI enhancement work. `provider` and `model` are recorded per Master Plan §6
/// step 6 ("store model/version, job timestamp, enhancement status").
model AiJob {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// PHOTO_ENHANCE | PHOTO_QUALITY | VIDEO_COVER | VIDEO_METADATA
  type          String    @db.VarChar(40)
  status        JobStatus @default(QUEUED)
  mediaId       String?   @map("media_id") @db.Uuid
  propertyId    String?   @map("property_id") @db.Uuid
  provider      String?   @db.VarChar(40)
  model         String?   @db.VarChar(160)
  modelVersion  String?   @map("model_version") @db.VarChar(160)
  /// The operations actually applied. Constrained to the allow-list in
  /// src/integrations/ai/allowed-operations.ts — generative edits are refused.
  operations    String[]
  providerJobId String?   @map("provider_job_id") @db.VarChar(160)
  costUsd       Decimal?  @map("cost_usd") @db.Decimal(10, 6)
  queueJobId    String?   @map("queue_job_id") @db.VarChar(80)
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3) @map("max_attempts")
  error         String?
  result        Json?
  startedAt     DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  media PropertyMedia? @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([mediaId])
  @@index([propertyId])
  @@map("ai_jobs")
}

// ---------------------------------------------------------------------------
// RIVO Maps & Traffic Engine — Master Plan §4
// ---------------------------------------------------------------------------

model RoadIncident {
  id               String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             IncidentType
  status           IncidentStatus                        @default(ACTIVE)
  point            Unsupported("geography(Point, 4326)")
  lat              Float
  lng              Float
  /// Direction of travel the report applies to, degrees from north. Null = both.
  headingDeg       Int?                                  @map("heading_deg")
  note             String?                               @db.VarChar(280)
  reportedById     String?                               @map("reported_by_id") @db.Uuid
  /// Net community score: +1 per confirmation, -1 per dismissal, plus a
  /// reporter-reputation seed. Drives visibility, not deletion.
  score            Int                                   @default(0)
  confirmCount     Int                                   @default(0) @map("confirm_count")
  dismissCount     Int                                   @default(0) @map("dismiss_count")
  /// 0..1. Combines score, reporter history and age.
  confidence       Float                                 @default(0.5)
  /// Set from INCIDENT_DEFAULT_TTL_MINUTES, extended by confirmations.
  expiresAt        DateTime                              @map("expires_at") @db.Timestamptz(3)
  /// Mapbox/OSM-style segment id once map matching has run.
  segmentKey       String?                               @map("segment_key") @db.VarChar(64)
  removedByAdminId String?                               @map("removed_by_admin_id") @db.Uuid
  removedReason    String?                               @map("removed_reason") @db.VarChar(200)
  isDemo           Boolean                               @default(false) @map("is_demo")
  createdAt        DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  reportedBy    User?                      @relation(fields: [reportedById], references: [id], onDelete: SetNull)
  removedBy     AdminUser?                 @relation(fields: [removedByAdminId], references: [id], onDelete: SetNull)
  confirmations RoadIncidentConfirmation[]

  @@index([status, expiresAt])
  @@index([type, status])
  @@index([reportedById])
  @@map("road_incidents")
}

model RoadIncidentConfirmation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId String   @map("incident_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// TRUE = "still there", FALSE = "not there".
  confirmed  Boolean
  /// Metres between the user and the incident when they voted; a vote from far
  /// away is weighted lower.
  distanceM  Int?     @map("distance_m")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  incident RoadIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([incidentId, userId])
  @@index([incidentId])
  @@map("road_incident_confirmations")
}

/// Raw, consented, pseudonymous speed samples. Deleted after
/// TELEMETRY_RAW_RETENTION_DAYS; only the aggregates survive (Master Plan §4:
/// "Minimize raw-location retention", "Never expose another user's raw track").
///
/// There is intentionally NO user_id column. Samples carry only a rotating
/// pseudonymous session id, so a track cannot be re-attached to an account.
model RoadSpeedSample {
  id         String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Rotating pseudonymous id, regenerated by the client at least daily.
  sessionKey String                                @map("session_key") @db.VarChar(64)
  point      Unsupported("geography(Point, 4326)")
  speedKph   Float                                 @map("speed_kph")
  headingDeg Int?                                  @map("heading_deg")
  accuracyM  Float?                                @map("accuracy_m")
  /// Populated by the map-matching step; null until matched.
  segmentKey String?                               @map("segment_key") @db.VarChar(64)
  recordedAt DateTime                              @map("recorded_at") @db.Timestamptz(3)
  createdAt  DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([segmentKey, recordedAt])
  @@index([createdAt])
  @@index([sessionKey])
  @@map("road_speed_samples")
}

/// Aggregated, k-anonymous speed per road segment per time bucket. This is the
/// only traffic data any request may read.
model RoadSpeedAggregate {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  segmentKey   String   @map("segment_key") @db.VarChar(64)
  /// Bucket start, truncated to TELEMETRY_BUCKET_MINUTES.
  bucketStart  DateTime @map("bucket_start") @db.Timestamptz(3)
  /// 0=Sunday .. 6=Saturday, in Asia/Baghdad. Enables "typical traffic" lookups.
  dayOfWeek    Int      @map("day_of_week")
  minuteOfDay  Int      @map("minute_of_day")
  sampleCount  Int      @map("sample_count")
  /// Distinct pseudonymous sessions. Aggregate is withheld below
  /// TELEMETRY_MIN_SAMPLES_PER_BUCKET distinct sessions.
  sessionCount Int      @map("session_count")
  avgSpeedKph  Float    @map("avg_speed_kph")
  p50SpeedKph  Float?   @map("p50_speed_kph")
  p85SpeedKph  Float?   @map("p85_speed_kph")
  /// Free-flow reference speed for the segment, learned over time.
  freeFlowKph  Float?   @map("free_flow_kph")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([segmentKey, bucketStart])
  @@index([segmentKey, dayOfWeek, minuteOfDay])
  @@index([bucketStart])
  @@map("road_speed_aggregates")
}

/// Driver feedback on a completed or abandoned route. Feeds ETA calibration.
model RouteFeedback {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  /// Correlates with the route returned by POST /maps/routes.
  routeRequestId   String   @map("route_request_id") @db.VarChar(64)
  originLat        Float    @map("origin_lat")
  originLng        Float    @map("origin_lng")
  destLat          Float    @map("dest_lat")
  destLng          Float    @map("dest_lng")
  /// ETA the app showed at departure, seconds.
  predictedSeconds Int      @map("predicted_seconds")
  /// Actual travel time, seconds. Null when the trip was abandoned.
  actualSeconds    Int?     @map("actual_seconds")
  distanceM        Int?     @map("distance_m")
  rerouteCount     Int      @default(0) @map("reroute_count")
  /// COMPLETED | ABANDONED | REROUTED_AWAY
  outcome          String   @db.VarChar(24)
  rating           Int?
  comment          String?  @db.VarChar(280)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([routeRequestId])
  @@map("route_feedback")
}

/// Home / Work / custom saved destinations — Master Plan §4 main map screen.
model SavedPlace {
  id        String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String                                @map("user_id") @db.Uuid
  /// HOME | WORK | CUSTOM
  kind      String                                @db.VarChar(16)
  label     String                                @db.VarChar(120)
  point     Unsupported("geography(Point, 4326)")
  lat       Float
  lng       Float
  address   String?                               @db.VarChar(300)
  createdAt DateTime                              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime                              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("saved_places")
}

// ---------------------------------------------------------------------------
// Admin, notifications, configuration — Master Plan §9
// ---------------------------------------------------------------------------

model AdminUser {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String    @unique @db.VarChar(200)
  /// scrypt hash. There is no password-reset-by-email flow in MVP; a Super Admin
  /// resets peers, which keeps the admin surface small and auditable.
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  displayName        String    @map("display_name") @db.VarChar(120)
  role               AdminRole @default(SUPPORT)
  isActive           Boolean   @default(true) @map("is_active")
  /// Forces a password change on next login (used for seeded/rotated accounts).
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions              AdminSession[]
  auditLogs             AuditLog[]
  moderatedProperties   Property[]
  reviewedVerifications SellerVerification[]
  resolvedReports       PropertyReport[]
  removedIncidents      RoadIncident[]
  settledPayments       ListingPayment[]

  @@index([role, isActive])
  @@map("admin_users")
}

model AdminSession {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId       String    @map("admin_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.VarChar(64)
  ip            String?   @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Why the session ended: logout | password_changed | account_disabled.
  revokedReason String?   @map("revoked_reason") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, revokedAt])
  @@map("admin_sessions")
}

/// Append-only. Master Plan §9: "Every sensitive action must create an audit-log entry."
/// Enforced at the database level by a trigger that rejects UPDATE and DELETE.
model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  /// e.g. property.approve, payment.settle_manual, user.block, flag.update
  action     String   @db.VarChar(80)
  /// property | user | payment | incident | reel | verification | flag | admin
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  /// Redacted diff of what changed. Never contains secrets or raw GPS tracks.
  changes    Json?
  reason     String?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  requestId  String?  @map("request_id") @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([adminId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// LISTING_APPROVED | LISTING_REJECTED | CHANGES_REQUESTED | PAYMENT_PAID |
  /// PAYMENT_FAILED | MEDIA_READY | REEL_READY | VERIFICATION_RESULT | SYSTEM
  type       String    @db.VarChar(40)
  titleAr    String    @map("title_ar") @db.VarChar(200)
  titleEn    String?   @map("title_en") @db.VarChar(200)
  bodyAr     String    @map("body_ar")
  bodyEn     String?   @map("body_en")
  /// Deep link target, e.g. rivo://property/<id>
  deepLink   String?   @map("deep_link") @db.VarChar(300)
  data       Json?
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  /// Push delivery outcome; null when push was not attempted.
  pushSentAt DateTime? @map("push_sent_at") @db.Timestamptz(3)
  pushError  String?   @map("push_error") @db.VarChar(300)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model FeatureFlag {
  key              String   @id @db.VarChar(80)
  enabled          Boolean
  description      String?
  /// Optional structured payload (e.g. rollout percentage, allow-list).
  config           Json?
  updatedByAdminId String?  @map("updated_by_admin_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("feature_flags")
}

/// Applied SQL migrations are tracked by Prisma's own _prisma_migrations table.
/// This table records one-off data/maintenance operations instead (backfills,
/// retention sweeps), so an operator can see what ran and when.
model MaintenanceRun {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  job        String    @db.VarChar(80)
  status     JobStatus @default(RUNNING)
  details    Json?
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([job, startedAt])
  @@map("maintenance_runs")
}
