{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:dev"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "autoAttachChildProcesses": true
    },
    {
      "name": "Worker (debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "worker:dev"],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "autoAttachChildProcesses": true
    },
    {
      "name": "Admin dashboard",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Mobile app (Android emulator)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/apps/mobile",
      "args": ["--dart-define=RIVO_API_BASE_URL=http://10.0.2.2:3000/api/v1"]
    },
    {
      "name": "Mobile app (physical device on this network)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}/apps/mobile",
      "args": ["--dart-define=RIVO_API_BASE_URL=http://${input:hostIp}:3000/api/v1"]
    },
    {
      "name": "API e2e tests",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test:e2e"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Everything (API + worker + admin)",
      "configurations": ["API (debug)", "Worker (debug)", "Admin dashboard"],
      "stopAll": true
    }
  ],
  "inputs": [
    {
      "id": "hostIp",
      "type": "promptString",
      "description": "This computer's IP on the local network — ipconfig on Windows, ifconfig on macOS/Linux",
      "default": "192.168.1.10"
    }
  ]
}
